# =====================================================================
# NexTrade — Docker Compose Environment Variables
# Copy this file to .env and fill in your actual values
# =====================================================================

# ── MongoDB ──────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/Stock

# ── JWT ──────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string-minimum-32-chars
JWT_EXPIRY=24h

# ── Google OAuth ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Finnhub Market Data ───────────────────────────────────────────────
MARKET_API_KEY=your_finnhub_api_key

# ── CORS / Frontend URL ───────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
REACT_APP_API_URL=http://localhost:10000

# ── Email (SMTP) ─────────────────────────────────────────────────────
MAIL_ENABLED=false
MAIL_FROM=NexTrade <no-reply@nextrade.app>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password

# ── SMS (Twilio) ──────────────────────────────────────────────────────
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# ── Grafana ───────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-production
